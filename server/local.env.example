# Copy to .env. All secrets stay on the server; never use VITE_ for secrets.
RECEIVING_ENABLED=false
APP_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/heart-collection.sqlite
ADMIN_USERNAME=
# At least 16 characters; use a unique random password.
ADMIN_PASSWORD=
# Optional: only needed for automatic verification. Manual review needs no API key.
EASYSLIP_API_KEY=
ROSE_BANK_CODE=
ROSE_BANK_NAME=
ROSE_ACCOUNT_NAME=
ROSE_ACCOUNT_NUMBER=
PRAEW_BANK_CODE=
PRAEW_BANK_NAME=
PRAEW_ACCOUNT_NAME=
PRAEW_ACCOUNT_NUMBER=
